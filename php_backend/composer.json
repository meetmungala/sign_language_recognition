{
    "name": "sign-language-platform/php-backend",
    "description": "PHP Backend for Sign Language Recognition Platform",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "monolog/monolog": "^3.0",
        "firebase/php-jwt": "^6.0",
        "vlucas/phpdotenv": "^5.0",
        "guzzlehttp/guzzle": "^7.0",
        "ramsey/uuid": "^4.0",
        "respect/validation": "^2.0",
        "phpmailer/phpmailer": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SignLanguagePlatform\\": "classes/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyze": "phpstan analyse classes/ --level=5"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
